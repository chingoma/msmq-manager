# MSMQ Manager - Environment Variables
# Copy to .env and set values before: docker-compose -f docker-compose.windows.yml up -d

# Required: PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/msmq_manager
SPRING_DATASOURCE_USERNAME=msmq
SPRING_DATASOURCE_PASSWORD=your_db_password

# Required: Redis (optional password if not set)
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Admin API auth
ADMIN_PASSWORD=replace_with_secure_admin_password

# MSMQ remote server (for status listener / remote queue access)
MSMQ_REMOTE_SERVER=192.168.2.170
